# Copy this file to .env and adjust values for your machine.
# Never commit real credentials.

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- API (NestJS) ---
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:3000

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=careerlens
DATABASE_PASSWORD=careerlens
DATABASE_NAME=careerlens
DATABASE_SYNC=false
DATABASE_MIGRATIONS_RUN=true

UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880

# Optional OpenAI-compatible embeddings. Leave blank to use the
# deterministic skill + lexical similarity fallback.
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
